<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.rojas.ian.controller.UsuariosController" spacing="12" prefWidth="820" prefHeight="540">
    <padding>
        <Insets top="18" right="18" bottom="18" left="18"/>
    </padding>
    <Label text="Gestión de Usuarios" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
    <GridPane hgap="10" vgap="8">
        <columnConstraints>
            <ColumnConstraints minWidth="85"/>
            <ColumnConstraints hgrow="ALWAYS"/>
            <ColumnConstraints minWidth="85"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>
        <Label text="Nombre:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="txtNombre" promptText="Nombre completo" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="Profesión:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
        <TextField fx:id="txtProfesion" promptText="Profesión" GridPane.rowIndex="0" GridPane.columnIndex="3"/>
    </GridPane>
    <HBox spacing="10">
        <Button text="Agregar usuario" onAction="#agregar"/>
        <Button text="Actualizar seleccionado" onAction="#actualizar"/>
        <Button text="Eliminar seleccionado" onAction="#eliminar"/>
        <Button text="Limpiar" onAction="#limpiar"/>
    </HBox>
    <TableView fx:id="tablaUsuarios" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="70"/>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="280"/>
            <TableColumn fx:id="colProfesion" text="Profesión" prefWidth="360"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>
</VBox>
